# Normalize line endings; LF in the repo, CRLF only where Windows demands it.
* text=auto eol=lf

*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

*.cpp   text diff=cpp
*.cc    text diff=cpp
*.cxx   text diff=cpp
*.hpp   text diff=cpp
*.hxx   text diff=cpp
*.h     text diff=cpp
*.c     text diff=cpp
*.inl   text diff=cpp

*.cmake text
CMakeLists.txt text

*.md    text
*.txt   text

# Binary content
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.dds   binary
*.bin   binary
*.dll   binary
*.exe   binary
*.lib   binary
*.pdb   binary
*.zip   binary
*.7z    binary
